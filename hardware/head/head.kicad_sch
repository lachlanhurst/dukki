  (text "I2C8: head IMU, ToF, breakout" (exclude_from_sim no) (at 197 186 0)
    (effects (font (size 2.0 2.0) bold) (justify left top)) (uuid "5a2bbee3-9851-50f0-9526-b48a68a1dfa4"))
  (text "BMI088 on the board, I2C: PS and CSB1 high, CSB2 open (allowed in I2C mode); SDO1 and SDO2 high:\naccelerometer 0x19, gyroscope 0x69 (strapped so the pin rows need no vias between alternate pins).\nR8, R9: the bus pull-ups (the ToF breakout adds 10k). Cut JP4 and JP5 to use an external IMU module on J3" (exclude_from_sim no) (at 197 190 0)
    (effects (font (size 1.27 1.27)) (justify left top)) (uuid "05ca6af3-1799-51ca-95cc-a4987cbac051"))
